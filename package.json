{
  "name": "linecut",
  "private": true,
  "version": "0.2.0",
  "description": "Subtitle indexing and media organization tool",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GCL-MAD-CLUB/LineCut.git"
  },
  "bugs": {
    "url": "https://github.com/GCL-MAD-CLUB/LineCut/issues"
  },
  "homepage": "https://github.com/GCL-MAD-CLUB/LineCut#readme",
  "type": "module",
  "packageManager": "npm@11.7.0",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "npm run check:errors && npm run check:architecture && tsc && vite build",
    "build:thumbnail-provider": "node scripts/build-thumbnail-provider.mjs",
    "prepare:transnetv2": "node scripts/prepare-transnetv2-assets.mjs",
    "prepare:ffmpeg": "node scripts/prepare-ffmpeg-assets.mjs",
    "check:errors": "node scripts/check-error-boundaries.mjs",
    "check:architecture": "node scripts/check-system-architecture.mjs",
    "check:versions": "node scripts/check-version-consistency.mjs",
    "check": "npm run format:frontend:check && npm run check:versions && npm run build",
    "format": "prettier --write . && npm run format:rust",
    "format:frontend:check": "prettier --check .",
    "format:check": "npm run format:frontend:check && npm run format:rust:check",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml && cargo fmt --manifest-path src-tauri/thumbnail-provider/Cargo.toml",
    "format:rust:check": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check && cargo fmt --manifest-path src-tauri/thumbnail-provider/Cargo.toml -- --check",
    "preview": "vite preview --host 127.0.0.1 --port 1421",
    "release:build": "node scripts/release.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.9",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "lucide-react": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.3",
    "prettier": "^3.9.4",
    "typescript": "^6.0.3",
    "vite": "^8.1.0"
  }
}
