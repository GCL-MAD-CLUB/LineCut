{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Locution Pro",
  "version": "0.3.3",
  "identifier": "com.linecut.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run prepare:semantic && npm run prepare:storyboard-semantic && npm run build",
    "beforeBundleCommand": "npm run prepare:transnetv2 && npm run build:thumbnail-provider",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": " Locution Pro",
        "width": 1320,
        "height": 860,
        "maximized": true,
        "minWidth": 1080,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "lcp"
        ],
        "name": "LocutionPro.Project",
        "description": "Locution Pro Project",
        "role": "Editor"
      }
    ],
    "externalBin": [
      "bin/ffmpeg",
      "bin/ffprobe"
    ],
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../src/assets/fonts/OFL.txt": "licenses/locution-pro-ui-sans-OFL.txt",
      "target/release/locution_pro_thumbnail_provider.dll": "locution_pro_thumbnail_provider.dll",
      "resources/transnetv2": "transnetv2",
      "resources/semantic-search": "semantic-search",
      "resources/storyboard-semantic": "storyboard-semantic"
    },
    "windows": {
      "nsis": {
        "installerHooks": "./windows/ffmpeg-options.nsh",
        "template": "./windows/installer.nsi",
        "languages": [
          "SimpChinese"
        ]
      }
    }
  }
}
